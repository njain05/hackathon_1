# Copy to .env and fill in. Never commit .env.
FRONTEND_ORIGINS=http://localhost:3000
# "Ask the timetable" helper (Claude Haiku). Backend only, never in the frontend.
# Leave it out and the helper says it isn't set up; everything else works.
# ANTHROPIC_API_KEY=
# Where colleges and published timetables are saved. Unset = SQLite file backend/timetable.db.
# Production: Supabase > Connect > "Session pooler" URI (postgresql://... is fine).
# DATABASE_URL=sqlite:///./timetable.db
